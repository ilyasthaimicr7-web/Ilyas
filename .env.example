# =============================================================================
# Horror Studio AI — Environment Configuration
# =============================================================================
# Copy this file: cp .env.example .env
# Then fill in your values. The .env file is gitignored and NEVER sent to
# the browser. Your API key stays on the server.
# =============================================================================

# Google Gemini API key.
# Get it at: https://aistudio.google.com/apikey
# (Free tier: ~1,500 requests/day, no credit card required)
GEMINI_API_KEY=

# Gemini model to use.
# Available: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
# Default: gemini-2.0-flash (fast, cost-effective, great for creative writing)
GEMINI_MODEL=gemini-2.0-flash

# Backend server port.
# Default: 8123
PORT=8123

# Set to "true" to allow loading .env from any directory (for development).
# Leave unset in production.
NODE_ENV=development

# ──  Stage 2: Video Production  ──────────────────────────
# Hugging Face API key for image generation (Stable Diffusion) and TTS.
# Get it at: https://huggingface.co/settings/tokens (free tier available)
# Required for video generation. Without it, video production is unavailable.
HF_API_KEY=

# Hugging Face model names (optional overrides)
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1024
HF_TTS_MODEL=facebook/fastspeech2-ljspeech
